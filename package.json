        "postcss": "^8.5.10",
        "postcss-loader": "^6.2.1",
        "postcss-rtlcss": "^6.0.0",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.49.7",
        "sass-loader": "^8.0.2",
        "tailwindcss": "^3.4.19",
        "webpack-bundle-analyzer": "^4.5.0",
        "webpack-cli": "^4.9.2",
        "webpack-i18n-extractor-plugin": "^2.0.7"
    }
}
