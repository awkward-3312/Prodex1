{
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "overrides": {
        "node-sass": "npm:sass@^1.49.7"
    },
    "scripts": {
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "test:frontend": "node --test tests/frontend/*.test.mjs",
        "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
        "test:e2e:smoke": "playwright test --config tests/e2e/playwright.config.js --grep @smoke",
        "test:e2e:headed": "playwright test --config tests/e2e/playwright.config.js --headed",
        "test:e2e:routes": "node tests/e2e/routes/route-snapshot.js --check",
        "test:e2e:compat-warnings": "node tests/e2e/scripts/compat-warnings-report.js",
        "test:e2e:routes:update": "node tests/e2e/routes/route-snapshot.js --update",
        "e2e:setup": "bash tests/e2e/scripts/setup.sh"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.15.11",
        "@alpinejs/focus": "^3.15.11",
        "@floating-ui/vue": "^2.0.1",
        "@internationalized/date": "^3.12.4",
        "@lucide/vue": "^1.48.0",
        "@stripe/stripe-js": "^1.20.3",
        "@unhead/vue": "^3.4.1",
        "@vee-validate/rules": "^4.15.1",
        "@vue/compat": "^3.5.43",
        "@vue/compiler-sfc": "^3.5.43",
        "@vuepic/vue-datepicker": "^14.0.0",
        "@vueuse/core": "^15.0.0",
        "@vueuse/integrations": "^15.0.0",
        "alpinejs": "^3.15.11",
        "apexcharts": "^5.16.0",
        "axios": "^1.7.7",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "bootstrap-vue-next": "^1.2.1",
        "core-js": "^3.19.0",
        "cross-env": "^7.0.3",
        "date-fns": "^4.4.0",
        "dompurify": "^3.2.4",
        "echarts": "^5.5.1",
        "echarts-gl": "^2.0.9",
        "focus-trap": "^8.2.2",
        "jsbarcode": "^3.12.3",
        "jspdf": "^3.0.3",
        "jspdf-autotable": "^5.0.2",
        "laravel-mix": "^6.0.41",
        "mini-css-extract-plugin": "^2.5.3",
        "mobile-device-detect": "^0.4.3",
        "moment": "^2.29.1",
        "moment-locales-webpack-plugin": "^1.2.0",
        "nprogress": "^0.2.0",
        "perfect-scrollbar": "^1.5.6",
        "quill": "^2.0.3",
        "reka-ui": "^2.10.4",
        "vee-validate": "^4.15.1",
        "vue": "^3.5.43",
        "vue-i18n": "^11.4.12",
        "vue-loader": "^16.8.3",
        "vue-router": "^4.6.4",
        "vue-sweetalert2": "^5.0.11",
        "vue3-apexcharts": "^1.11.1",
        "vuedraggable": "^4.1.0",
        "vuex": "^3.6.2",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "@vue/eslint-config-prettier": "^6.0.0",
        "autoprefixer": "^10.5.0",
        "babel-eslint": "^10.1.0",
