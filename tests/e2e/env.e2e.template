# Plantilla del .env.e2e que genera scripts/setup.sh (Laravel lo carga cuando APP_ENV=e2e).
# Nunca se usa el .env de desarrollo. Los valores entre @@ los rellena setup.sh desde variables de entorno.
APP_NAME=PRODEX-E2E
APP_ENV=e2e
APP_KEY=@@APP_KEY@@
APP_DEBUG=true
APP_URL=http://127.0.0.1:@@E2E_PORT@@
CENTRAL_DOMAINS=127.0.0.1,localhost
LOG_CHANNEL=single
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=@@E2E_DB_PORT@@
DB_DATABASE=prodex_e2e_central
DB_USERNAME=root
DB_PASSWORD=@@E2E_DB_PASSWORD@@
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BROADCAST_DRIVER=log
